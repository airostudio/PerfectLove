# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# OpenAI (for AI reading text and soulmate/future-baby sketch image generation)
OPENAI_API_KEY=your_openai_api_key

# Resend
RESEND_API_KEY=your_resend_api_key
# RESEND_TEST_EMAIL=  # When set, all outgoing emails are redirected to this address (useful for testing)

# Vercel Cron
CRON_SECRET=your_cron_secret

# App
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# Admin dashboard (app/admin) — the password checked at /admin/login
ADMIN_SECRET=your_admin_secret

# Partner redemption (POST /api/perfect-love/redeem) — shared secret a
# partner site's backend sends as the X-Perfect-Love-Secret header. Generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PARTNER_REDEEM_SECRET=your_partner_redeem_secret
